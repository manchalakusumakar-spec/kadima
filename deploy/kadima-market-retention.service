[Unit]
Description=Seven-day NIFTY and BANKNIFTY market-data retention

[Service]
Type=oneshot
TimeoutStartSec=2h
User=ubuntu
WorkingDirectory=/home/ubuntu/kadima-py
ExecStart=/usr/bin/python3 /home/ubuntu/kadima-py/tools/market_data_retention.py --apply
Nice=15
IOSchedulingClass=idle
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/kadima

