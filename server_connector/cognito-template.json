{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Dedicated KADIMA read-only connector login for Claude (and optionally ChatGPT). No EC2, IAM, broker or trading changes.",
  "Parameters": {
    "ChatGPTRedirectUri": {
      "Type": "String",
      "Description": "Optional. Exact OAuth callback copied from a ChatGPT connection; leave empty for Claude only. Never guess it.",
      "AllowedPattern": "^$|https://chatgpt[.]com/connector(?:_platform_oauth_redirect|/oauth/[A-Za-z0-9_-]+)",
      "Default": ""
    },
    "LoginDomainPrefix": {
      "Type": "String",
      "Description": "Available Cognito login-domain prefix in this AWS region.",
      "MinLength": 3,
      "MaxLength": 50,
      "AllowedPattern": "[a-z0-9][a-z0-9-]*[a-z0-9]"
    }
  },
  "Resources": {
    "OperatorPool": {
      "Type": "AWS::Cognito::UserPool",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "UserPoolName": {
          "Fn::Sub": "${AWS::StackName}-operator"
        },
        "UserPoolTier": "ESSENTIALS",
        "DeletionProtection": "ACTIVE",
        "AdminCreateUserConfig": {
          "AllowAdminCreateUserOnly": true
        },
        "UsernameConfiguration": {
          "CaseSensitive": false
        },
        "MfaConfiguration": "ON",
        "EnabledMfas": [
          "SOFTWARE_TOKEN_MFA"
        ],
        "AccountRecoverySetting": {
          "RecoveryMechanisms": [
            {
              "Name": "admin_only",
              "Priority": 1
            }
          ]
        },
        "Policies": {
          "PasswordPolicy": {
            "MinimumLength": 14,
            "RequireLowercase": true,
            "RequireUppercase": true,
            "RequireNumbers": true,
            "RequireSymbols": true,
            "TemporaryPasswordValidityDays": 1
          }
        }
      }
    },
    "ReadOnlyResource": {
      "Type": "AWS::Cognito::UserPoolResourceServer",
      "Properties": {
        "UserPoolId": {
          "Ref": "OperatorPool"
        },
        "Identifier": "kadima",
        "Name": "KADIMA diagnostics",
        "Scopes": [
          {
            "ScopeName": "read",
            "ScopeDescription": "Read sanitized KADIMA operational evidence"
          }
        ]
      }
    },
    "ChatGPTClient": {
      "Type": "AWS::Cognito::UserPoolClient",
      "DependsOn": "ReadOnlyResource",
      "Properties": {
        "UserPoolId": {
          "Ref": "OperatorPool"
        },
        "ClientName": "kadima-chatgpt-readonly",
        "GenerateSecret": false,
        "AllowedOAuthFlowsUserPoolClient": true,
        "AllowedOAuthFlows": [
          "code"
        ],
        "AllowedOAuthScopes": [
          "openid",
          "kadima/read"
        ],
        "SupportedIdentityProviders": [
          "COGNITO"
        ],
        "CallbackURLs": [
          {
            "Ref": "ChatGPTRedirectUri"
          }
        ],
        "PreventUserExistenceErrors": "ENABLED",
        "EnableTokenRevocation": true,
        "AccessTokenValidity": 5,
        "IdTokenValidity": 5,
        "RefreshTokenValidity": 7,
        "TokenValidityUnits": {
          "AccessToken": "minutes",
          "IdToken": "minutes",
          "RefreshToken": "days"
        }
      },
      "Condition": "HasChatGPT"
    },
    "LoginDomain": {
      "Type": "AWS::Cognito::UserPoolDomain",
      "Properties": {
        "UserPoolId": {
          "Ref": "OperatorPool"
        },
        "Domain": {
          "Ref": "LoginDomainPrefix"
        },
        "ManagedLoginVersion": 2
      }
    },
    "LoginBranding": {
      "Type": "AWS::Cognito::ManagedLoginBranding",
      "DependsOn": "LoginDomain",
      "Properties": {
        "UserPoolId": {
          "Ref": "OperatorPool"
        },
        "ClientId": {
          "Ref": "ChatGPTClient"
        },
        "UseCognitoProvidedValues": true
      },
      "Condition": "HasChatGPT"
    },
    "ClaudeClient": {
      "Type": "AWS::Cognito::UserPoolClient",
      "DependsOn": "ReadOnlyResource",
      "Properties": {
        "UserPoolId": {
          "Ref": "OperatorPool"
        },
        "ClientName": "kadima-claude-readonly",
        "GenerateSecret": false,
        "AllowedOAuthFlowsUserPoolClient": true,
        "AllowedOAuthFlows": [
          "code"
        ],
        "AllowedOAuthScopes": [
          "openid",
          "kadima/read"
        ],
        "SupportedIdentityProviders": [
          "COGNITO"
        ],
        "CallbackURLs": [
          "https://claude.ai/api/mcp/auth_callback"
        ],
        "PreventUserExistenceErrors": "ENABLED",
        "EnableTokenRevocation": true,
        "AccessTokenValidity": 15,
        "IdTokenValidity": 15,
        "RefreshTokenValidity": 7,
        "TokenValidityUnits": {
          "AccessToken": "minutes",
          "IdToken": "minutes",
          "RefreshToken": "days"
        }
      }
    },
    "ClaudeLoginBranding": {
      "Type": "AWS::Cognito::ManagedLoginBranding",
      "DependsOn": "LoginDomain",
      "Properties": {
        "UserPoolId": {
          "Ref": "OperatorPool"
        },
        "ClientId": {
          "Ref": "ClaudeClient"
        },
        "UseCognitoProvidedValues": true
      }
    }
  },
  "Outputs": {
    "UserPoolId": {
      "Value": {
        "Ref": "OperatorPool"
      }
    },
    "ClientId": {
      "Value": {
        "Ref": "ChatGPTClient"
      },
      "Condition": "HasChatGPT"
    },
    "ReadScope": {
      "Value": "kadima/read"
    },
    "ClaudeClientId": {
      "Value": {
        "Ref": "ClaudeClient"
      },
      "Description": "Enter this as the OAuth client ID in Claude's custom connector dialog; leave the secret empty."
    },
    "ClaudeRedirectUri": {
      "Value": "https://claude.ai/api/mcp/auth_callback"
    }
  },
  "Conditions": {
    "HasChatGPT": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "ChatGPTRedirectUri"
            },
            ""
          ]
        }
      ]
    }
  }
}
