[Unit]
Description=KADIMA read-only MCP diagnostics
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kadima-reader
Group=kadima-reader
WorkingDirectory=/opt/kadima-connector/current
ExecStart=/opt/kadima-connector/current/venv/bin/python -B -m server_connector.server
LoadCredential=oauth-config:/etc/kadima-connector/oauth.json
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
InaccessiblePaths=/var/lib/kadima /etc/kadima-dashboard
ReadOnlyPaths=/var/lib/kadima-connector
MemoryMax=128M
TasksMax=32
CPUQuota=25%

[Install]
WantedBy=multi-user.target
