# Gamma timing outcome job (phase 1, record only). Oneshot, triggered by
# kadima-timing-outcome.timer after the F&O close. Reads the day's timing
# lines and the database read-only; never calls the broker.
#
# Paths and env files match kadima.service as seen on 2026-09-29.
[Unit]
Description=KADIMA Gamma timing outcome job
After=network.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/kadima-py
EnvironmentFile=-/etc/kadima/auto-execution.env
EnvironmentFile=-/etc/kadima/session-auto.env
EnvironmentFile=-/var/lib/kadima-autotrading-20260928/trading.env
ExecStart=/home/ubuntu/kadima-py/venv/bin/python3 -m kadima.timing_outcome --quiet
Nice=10
MemoryMax=200M
